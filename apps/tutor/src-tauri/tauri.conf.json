{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ERG Classroom",
  "identifier": "vn.edu.erg.classroom.tutor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3333",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ERG Classroom",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560,
        "transparent": true,
        "windowEffects": { "effects": ["mica"] }
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
