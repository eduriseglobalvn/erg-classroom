{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ERG Classroom Student",
  "identifier": "vn.edu.erg.classroom.student",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": { "csp": null, "assetProtocol": { "enable": true, "scope": ["$DOCUMENT/ERG/Received/**"] } }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
